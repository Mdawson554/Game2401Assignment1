%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 696fefaadd2962c4bb250caf4415b9af, type: 3}
  m_Name: Mercer
  m_EditorClassIdentifier: Assembly-CSharp::_Project.ScriptableObjects.DialogueSO
  DialogueArray:
  - Dialogue: 'MELISSA: Excuse me. Have you seen Joshua Gray?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'PATRON: Joshua? I saw him earlier. He was drinking by the fireplace,
      unless he''s wandered over to the smaller dance floor again.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'PATRON: That''s one way of putting it. Joshua knows everyone here,
      and everyone seems to know him. He''s usually drinking, talking, or doing both
      badly.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Sounds like the kind of person who hears a lot.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'PATRON: He does. Yes. But be careful around him; he stirs up a lot
      of trouble.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Really, what sort of trouble?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'PATRON: There''s gossip of some bad people around here; Joshua is
      the type to make a real mess of things for people. I won''t say much else;
      just be careful around here, please.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Fair enough. I appreciate the help.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'PATRON: Of course. Just be careful upstairs.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    ProducedMarkers: {fileID: 11400000, guid: 504df0e40d3b44e46aa7d13a53885ea2, type: 2}
    LockedDialogue: I should pay for my entry fee
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'PATRON: You came back?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Yes, it''s been an awfully long night chasing around what
      happened last Friday.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'PATRON:  I was beginning to wonder whether Ray had finally managed
      to scare you away.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Ray told me to find you.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'PATRON: Did he?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: He thinks you''re trying to make him take the blame for what
      happened.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Maybe. But I''ve spent the night following the trail, and
      every time I thought I was getting somewhere, I found another reason to look
      at Ray. '
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: A bloody coat, a fight, weapons, a bouncer who was terrified
      of telling me what he saw.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: And you think that was all arranged?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: That''s quite a conclusion.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: It''s an observation. When I first met you, you warned me
      about Ray before I even knew his name. '
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: You knew enough about the club to tell me where to look,
      and you talked about Jimmy like he was already gone.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: People speak carelessly.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Maybe. But I don''t think you''re careless.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: You''re very confident.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: I''m not confident. I''m suspicious. There''s a difference.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: And what exactly are you suspicious of?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: That someone wanted me looking at Ray while they stayed somewhere
      I wouldn''t think to look.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: You think that''s me?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: I think Ray does. I think the bouncer is afraid of whoever
      gave him orders. I think the staff have been threatened into keeping quiet,
      and I think you knew things about Jimmy before I told you enough to know them
      yourself.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: None of that proves anything.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: No. But it does make you worth asking questions.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: Fine. I knew Jimmy was in trouble. I knew Ray had been dealing
      with him, and I knew that after their fight people would naturally look at
      Ray. I made sure people kept their heads down.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: You helped make Ray look guilty.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: I never told anyone to kill Jimmy.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: I didn''t ask if you killed him. I asked what you did.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: I kept my business quiet.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: That''s not all.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: No. It isn''t.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: The watch.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: What about it?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Jimmy''s father''s watch. You knew he was selling it, and
      Ray says he never had it. Where is it?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: I got it from Jimmy. He needed money, and I gave him some.
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: And then you kept it.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Where is it? Somewhere nearby? Where?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: On one of the tables. I don''t remember which.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: You don''t remember where you put the one thing that could
      connect you to Jimmy?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MERCER: I didn''t think you''d get this far.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: That''s the first honest thing you''ve said to me.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think this person can help me now.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: Take the damn thing. it's over by the table near the fireplace.
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: ee8337a932d1c544fb5c9d8cae914c5c, type: 2}
    ProducedMarkers: {fileID: 11400000, guid: 78433ba4ea63aa84ab3fae25b98f8b04, type: 2}
    LockedDialogue: 'I should take the watch. '
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: StoryOver
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: f6388b813dbbd0848be677f542c0b537, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I've caught him now!
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  assignedType: 1
