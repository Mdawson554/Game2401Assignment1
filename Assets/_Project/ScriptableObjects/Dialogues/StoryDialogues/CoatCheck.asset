MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 696fefaadd2962c4bb250caf4415b9af, type: 3}
  m_Name: CoatCheck
  m_EditorClassIdentifier: Assembly-CSharp::_Project.ScriptableObjects.DialogueSO
  DialogueArray:
  - Dialogue: 'MELISSA: Hey, how are you doing?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 0}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: 
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: Ah, it''s going. You know how it is.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 0}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: 
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: How much is the cover?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 0}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: 
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: Five dollars.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 0}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: 
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Thanks. I''m looking for Joshua Gray. Do you know him?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 0}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: 
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: Everyone knows Joshua. Try the fireplace; that''s
      usually where he ends up.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 0}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: 
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: Best of luck. He can be a handful sometimes.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 0}
    ProducedMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    LockedDialogue: 
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: Best of luck. He can be a handful sometimes.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 0}
    ProducedMarkers: {fileID: 11400000, guid: c1236a5d1ec5aa74981a7c5f758a6ac7, type: 2}
    LockedDialogue: I should leave now
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: The janitor sent me here. I''m trying to figure out what
      was left behind after the fight upstairs; nobody has to know about this conversation.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: You seem very uncomfortable with me being here.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: i''m uncomfortable with anyone asking questions.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Why?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: Because we''ve been warned. Someone told us
      that people might start asking questions and that we were supposed to cooperate,
      send people where we were told, and keep our mouths shut.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Who?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: "COAT CHECK ATTENDANT: It's not safe enough to say. I was never given
      a name\u2014just instructions. We've worked here long enough to know when something
      is wrong, and we've been trying to keep our heads down."
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: You don''t have to put yourselves in danger for me. Is there
      anyone else who might know what happened?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: There''s only one person who was able to move
      in and out of VIP that night, someone who was close with Ray. I can''t say
      much else.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: You should probably see what was left in the
      back.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: Ray''s coat?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: Yes.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'MELISSA: A mess?'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I should come back later
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: 'COAT CHECK ATTENDANT: Yes.'
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: 857af2219300ea54abc70e344f6d3449, type: 2}
    ProducedMarkers: {fileID: 11400000, guid: d302df14d08fe6c4d9837ec8067546fb, type: 2}
    LockedDialogue: I don't think I should talk to them anymore.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  - Dialogue: Story Over
    DialogueColor: {r: 0, g: 0, b: 0, a: 1}
    RequiredMarkers: {fileID: 11400000, guid: f6388b813dbbd0848be677f542c0b537, type: 2}
    ProducedMarkers: {fileID: 0}
    LockedDialogue: I don't think I should talk to them anymore.
    LockedDialogueColor: {r: 1, g: 0, b: 0, a: 1}
  assignedType: 1
